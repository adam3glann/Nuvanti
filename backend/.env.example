NODE_ENV=development
PORT=4000
ADMIN_PORT=4001
TRUST_PROXY=0
DATABASE_URL=postgresql://nuvanti:nuvanti@localhost:5432/nuvanti
# Use a long random value in production (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret
STORE_ORIGIN=http://localhost:8080
ADMIN_ORIGIN=http://localhost:4001
API_PUBLIC_URL=http://localhost:4000
# Leave blank to issue a host-only session cookie from the API domain.
COOKIE_DOMAIN=
# The public, HTTPS address of the admin portal. No trailing slash.
ADMIN_APP_URL=http://localhost:4001
# Public storefront and admin assets are configured to call api.<your-domain> by default.
# For unrelated domains, set window.NUVANTI_API_URL in each app to this API's HTTPS origin.
# SMTP provider account for transactional emails (password resets, admin
# setup links, order confirmations). Use an app password, never your normal
# Gmail password. Leave blank only for local UI development.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nuvanti Security <security@example.com>"
# Optional: WhatsApp order-confirmation messages via Twilio's WhatsApp API.
# Leave blank to skip WhatsApp entirely — it never blocks checkout either
# way. TWILIO_WHATSAPP_FROM is the E.164 number Twilio gave you for your
# WhatsApp sender (e.g. your Sandbox number while testing).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Cloudinary product-image storage. Keep API_SECRET private; it is used only
# by the server, never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
