NODE_ENV=development
PORT=4000
ADMIN_PORT=4001
TRUST_PROXY=0
NUVANTI_PROXY_IP_SECRET=generate-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
# Optional in local development. In production, paste the Supabase Database
# Settings > SSL Configuration root CA certificate here to verify PostgreSQL TLS.
DATABASE_SSL_CA=
# Use a long random value in production (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret
# Stable random key used to encrypt authenticator secrets at rest. Do not rotate after enabling MFA unless you re-encrypt existing MFA secrets.
MFA_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
STORE_ORIGIN=http://localhost:8080
ADMIN_ORIGIN=http://localhost:4001
API_PUBLIC_URL=http://localhost:4000
# Leave blank to issue a host-only session cookie from the API domain.
COOKIE_DOMAIN=
# The public, HTTPS address of the admin portal. No trailing slash.
ADMIN_APP_URL=http://localhost:4001
# The storefront defaults to https://nuvanti-shop.pages.dev in production.
# Render and Railway expose the backend service origin automatically.
# For local development, set window.NUVANTI_API_URL to the local API URL if needed.
# Transactional mail can use Gmail API, SendGrid or Resend HTTPS APIs, or SMTP
# where the hosting provider permits it. Keep credentials private.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nuvanti Security <security@example.com>"
# Optional: WhatsApp order-confirmation messages via Twilio's WhatsApp API.
# Leave blank to skip WhatsApp entirely — it never blocks checkout either
# way. TWILIO_WHATSAPP_FROM is the E.164 number Twilio gave you for your
# WhatsApp sender (e.g. your Sandbox number while testing).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Cloudinary product-image storage. Keep API_SECRET private; it is used only
# by the server, never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Paymob hosted checkout (EGP). Keep secret/HMAC values server-side only.
# Use matching test or live credentials and integration IDs from Paymob.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_PAYMENT_METHODS=
PAYMOB_HMAC_SECRET=
