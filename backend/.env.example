NODE_ENV=development
PORT=4000
ADMIN_PORT=4001
DATABASE_URL=postgresql://nuvanti:nuvanti@localhost:5432/nuvanti
# Use a long random value in production (at least 32 characters).
JWT_SECRET=replace-with-a-long-random-secret
STORE_ORIGIN=http://localhost:8080
ADMIN_ORIGIN=http://localhost:4001
# In production with admin.example.com + api.example.com, set COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=
# The public, HTTPS address of the admin portal. No trailing slash.
ADMIN_APP_URL=http://localhost:4001
# SMTP provider account for password-reset emails. Use an app password, never
# your normal Gmail password. Leave blank only for local UI development.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nuvanti Security <security@example.com>"
